# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Use the canonical HTTPS origin in production (for example, https://unlockededu.com).
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAILS=

STRIPE_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PRO_MONTHLY_PRICE_ID=price_monthly_placeholder
STRIPE_PRO_ANNUAL_PRICE_ID=price_annual_placeholder

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional secret mixed into privacy-preserving rate-limit keys.
RATE_LIMIT_SECRET=

# Notification scheduler and Resend transactional email.
# Generate CRON_SECRET with: openssl rand -base64 32
CRON_SECRET=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# Example: UnlockED <updates@notify.unlockededu.com>
NOTIFICATION_EMAIL_FROM=
# Development never sends email unless this is explicitly set to 1.
NOTIFICATION_EMAIL_TEST_SEND=0
